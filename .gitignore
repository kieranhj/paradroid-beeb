# ---- Build output ----
# build.ps1 puts everything it produces in build/ — the disc image, the 200K
# copy for jsbeeb, and beebasm's assembly listing
build/
*.SSD
*.ssd
*.dsd
compile.txt
*.labels

# beebasm's SAVE writes a loose host file whenever it has no disc image to
# put it in — so any run without a working -do, the -d symbol dump included,
# drops these six in the project root
/PARA
/PARADAT
/PARASPR
/PARSPR2
/PARXFER
/PARAFNT

# ---- Third-party tools (fetch locally, see README) ----
bin/

# ---- Original game code and data ----
# Copyright Andrew Braybrook / Hewson Consultants. Supply these locally;
# they are inputs to the tools in tools/, not part of this project.
*.lst
*.prg
*.zip
extracted/
# ref/ holds screenshots of the original running, used to check the port
# against. Same copyright position; keep them locally.
ref/

# ---- Generated artefacts ----
# paradroid_ce_annotated.asm is produced by annotate.py from paradroid_ce.lst
paradroid_ce_annotated.asm
# tools/output/ is produced by the rip_*.py scripts
tools/output/
# src/data/ is produced by tools/export_bbc.py — converted game artwork and
# level data, so copyright as above. Regenerate it; do not commit it.
src/data/

# ---- Python ----
__pycache__/
*.pyc

# ---- Local editor / agent settings ----
.claude/settings.local.json
.labels.json
docs/Kieran's Human Notes.txt
